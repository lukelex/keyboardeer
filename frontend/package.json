    "@types/node": "24.10.1",
    "prettier": "3.8.2",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vite": "7.3.0"
  }
}
